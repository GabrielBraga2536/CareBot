<?xml version="1.0"?>
<robot name="robot_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- ARGUMENTOS                                                    -->
  <!-- ============================================================ -->
  <xacro:arg name="sim_mode" default="false" />

  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="$(find carebot_description)/urdf/robot_diff.gazebo" />
  </xacro:if>
  <xacro:unless value="$(arg sim_mode)">
    <xacro:include filename="$(find carebot_description)/urdf/ros2_control.xacro" />
  </xacro:unless>

  <!-- ============================================================ -->
  <!-- MATERIAIS                                                     -->
  <!-- ============================================================ -->
  <material name="chassis_white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>
  
  <material name="profile_gray">
    <color rgba="0.75 0.75 0.75 1.0"/>
  </material>

  <material name="wheel_dark">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- PROPRIEDADES FÍSICAS E DIMENSÕES                              -->
  <!-- ============================================================ -->

  <!-- Base (chapa): 520x400x6mm -->
  <xacro:property name="base_x"         value="0.520"/>
  <xacro:property name="base_y"         value="0.400"/>
  <xacro:property name="base_z"         value="0.006"/>

  <!-- Rodas: D=118mm, E=30mm -->
  <xacro:property name="roda_r"         value="0.059"/>
  <xacro:property name="roda_e"         value="0.030"/>

  <!-- Layout e alturas -->
  <xacro:property name="clearance"      value="0.017"/>
  <xacro:property name="base_link_z"    value="0.020"/>   <!-- base inferior acima do chão -->
  <xacro:property name="roda_z_rel"     value="0.039"/>   <!-- centro roda relativo base_link -->

  <!-- Posições das rodas no plano XY -->
  <xacro:property name="rx"             value="0.1677"/>
  <xacro:property name="ry"             value="0.1677"/>

  <!-- ============================================================ -->
  <!-- MACROS VISUAIS / ESTRUTURAIS                                  -->
  <!-- ============================================================ -->

  <!-- Macro para Prateleiras (adiciona visual e colisão correspondente) -->
  <xacro:macro name="plate_box" params="length width thickness z_center">
    <visual>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry>
        <box size="${length} ${width} ${thickness}"/>
      </geometry>
    </collision>
  </xacro:macro>


  <!-- Macro para a Chapa Base com Recortes para as Rodas -->
  <xacro:macro name="base_plate_with_holes" params="z_center">
    <!-- 1. Espinha Central (Cobre o robô de ponta a ponta, mas passa entre as rodas esquerda e direita) -->
    <visual>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.520 0.295 0.006"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.520 0.295 0.006"/></geometry>
    </collision>

    <!-- 2. Corpo Central Largo (Cobre a largura total, mas fica entre as rodas dianteiras e traseiras) -->
    <visual>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.215 0.400 0.006"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.215 0.400 0.006"/></geometry>
    </collision>

    <!-- 3. Borda Frontal (Fecha a frente das rodas) -->
    <visual>
      <origin xyz="0.244 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.032 0.400 0.006"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0.244 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.032 0.400 0.006"/></geometry>
    </collision>

    <!-- 4. Borda Traseira (Fecha a traseira das rodas) -->
    <visual>
      <origin xyz="-0.244 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.032 0.400 0.006"/></geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="-0.244 0 ${z_center}" rpy="0 0 0"/>
      <geometry><box size="0.032 0.400 0.006"/></geometry>
    </collision>
  </xacro:macro>


  <!-- Macro para Perfis de Alumínio Verticais -->
  <xacro:macro name="pillar_box" params="x y z_center length_z size_x:=0.04 size_y:=0.02">
    <visual>
      <origin xyz="${x} ${y} ${z_center}" rpy="0 0 0"/>
      <geometry>
        <box size="${size_x} ${size_y} ${length_z}"/>
      </geometry>
      <material name="profile_gray"/>
    </visual>
    <collision>
      <origin xyz="${x} ${y} ${z_center}" rpy="0 0 0"/>
      <geometry>
        <box size="${size_x} ${size_y} ${length_z}"/>
      </geometry>
    </collision>
  </xacro:macro>


  <!-- Macro para Perfis Horizontais (Eixo Y) -->
  <xacro:macro name="horizontal_profile_y" params="x z length size_x:=0.04 size_z:=0.02">
    <visual>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <geometry>
        <box size="${size_x} ${length} ${size_z}"/>
      </geometry>
      <material name="profile_gray"/>
    </visual>
    <collision>
      <origin xyz="${x} 0 ${z}" rpy="0 0 0"/>
      <geometry>
        <box size="${size_x} ${length} ${size_z}"/>
      </geometry>
    </collision>
  </xacro:macro>


  <!-- ============================================================ -->
  <!-- MACRO: RODA MOTRIZ                                            -->
  <!-- ============================================================ -->
  <xacro:macro name="roda_motriz" params="nome x y axis_y:=1">
    <link name="${nome}">
      <visual>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.000697" ixy="0" ixz="0"
                 iyy="0.000697" iyz="0"
                 izz="0.001393"/>
      </inertial>
    </link>
    <joint name="${nome}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${nome}"/>
      <origin xyz="${x} ${y} ${roda_z_rel}" rpy="0 0 0"/>
      <axis xyz="0 ${axis_y} 0"/>
      <dynamics damping="0.1" friction="0.2"/>
      <limit effort="100" velocity="20"/>
    </joint>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- MACRO: CASTER WHEEL                                           -->
  <!-- ============================================================ -->
  <xacro:macro name="caster" params="nome x y">
    <link name="${nome}">
      <visual>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="wheel_dark"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.000436" ixy="0" ixz="0"
                 iyy="0.000436" iyz="0"
                 izz="0.000871"/>
      </inertial>
    </link>
    <joint name="${nome}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${nome}"/>
      <origin xyz="${x} ${y} ${roda_z_rel}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.0" friction="0.0"/>
      <limit effort="0" velocity="20"/>
    </joint>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- FRAMES BASE                                                   -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="${rx} 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- BASE_LINK (ESTRUTURA COMPLETA DO ROBÔ)                       -->
  <!-- ============================================================ -->
  <link name="base_link">
    <!-- ==================== BANDEJAS PRINCIPAIS (1 a 4) ==================== -->
    <!-- Chapa 1 / Base (Com recortes para as rodas, Z = 0.08) -->
    <xacro:base_plate_with_holes z_center="0.08"/>
    
    <!-- Chapa 2 (Z = 0.16) -->
    <xacro:plate_box length="${base_x}" width="${base_y}" thickness="${base_z}" z_center="0.16"/>
    
    <!-- Chapa 3 (Z = 0.24) -->
    <xacro:plate_box length="${base_x}" width="${base_y}" thickness="${base_z}" z_center="0.24"/>
    
    <!-- Chapa 4 (Z = 0.32) -->
    <xacro:plate_box length="${base_x}" width="${base_y}" thickness="${base_z}" z_center="0.32"/>


    <!-- ==================== PERFIS HORIZONTAIS (EIXOS DAS RODAS) ==================== -->
    <!-- Perfil Frontal (X = 0.1677). Z=0.05 o posiciona logo abaixo da chapa principal -->
    <xacro:horizontal_profile_y x="0.1677" z="0.068" length="0.300"/>

    <!-- Perfil Traseiro (X = -0.1677) -->
    <xacro:horizontal_profile_y x="-0.1677" z="0.068" length="0.300"/>


    <!-- ==================== PILARES ENTRE BANDEJAS ==================== -->
    <!-- Nível 1 -> 2 (Vão de 0.08 a 0.16 | length_z = 0.08 | z_center = 0.12) -->
    <xacro:pillar_box x="-0.1677" y="0.14"  z_center="0.12" length_z="0.08"/>
    <xacro:pillar_box x="-0.1677" y="-0.14" z_center="0.12" length_z="0.08"/>

    <!-- Nível 2 -> 3 (Vão de 0.16 a 0.24 | length_z = 0.08 | z_center = 0.20) -->
    <xacro:pillar_box x="-0.1677" y="0.14"  z_center="0.20" length_z="0.08"/>
    <xacro:pillar_box x="-0.1677" y="-0.14" z_center="0.20" length_z="0.08"/>

    <!-- Nível 3 -> 4 (Vão de 0.24 a 0.32 | length_z = 0.08 | z_center = 0.28) -->
    <xacro:pillar_box x="-0.1677" y="0.14"  z_center="0.28" length_z="0.08"/>
    <xacro:pillar_box x="-0.1677" y="-0.14" z_center="0.28" length_z="0.08"/>


    <!-- ==================== MASTRO FRONTAL CENTRAL ÚNICO ==================== -->
    <!-- Da Chapa 1 (Z=0.08) até a Chapa 5 (Z=0.58). Altura = 0.50, Centro Z = 0.33 -->
    <visual>
      <origin xyz="0.1677 0.0 0.33" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.50"/>
      </geometry>
      <material name="profile_gray"/>
    </visual>
    <collision>
      <origin xyz="0.1677 0.0 0.33" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.02 0.50"/>
      </geometry>
    </collision>


    <!-- ==================== REFORÇO CHANFRADO CENTRAL ==================== -->
    <visual>
      <origin xyz="0.1287 0.0 0.52" rpy="0 -0.7854 0"/>
      <geometry>
        <box size="0.029 0.03 0.14"/>
      </geometry>
      <material name="profile_gray"/>
    </visual>


    <!-- ==================== BANDEJA SUPERIOR 5 (Topo do Robô) ==================== -->
    <visual>
      <origin xyz="0.120 0.0 0.58" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.32 ${base_z}"/>
      </geometry>
      <material name="chassis_white"/>
    </visual>
    <collision>
      <origin xyz="0.120 0.0 0.58" rpy="0 0 0"/>
      <geometry>
        <box size="0.28 0.32 ${base_z}"/>
      </geometry>
    </collision>

    <!-- Inércia combinada do robô -->
    <inertial>
      <origin xyz="-0.02 0 0.15" rpy="0 0 0"/>
      <mass value="9.0"/>
      <inertia ixx="0.12" ixy="0" ixz="0"
               iyy="0.18" iyz="0"
               izz="0.24"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!-- RODAS MOTRIZES TRASEIRAS                                      -->
  <!-- ============================================================ -->
  <xacro:roda_motriz nome="wheel_left"  x="-${rx}" y=" ${ry}" axis_y="1"/>
  <xacro:roda_motriz nome="wheel_right" x="-${rx}" y="-${ry}" axis_y="1"/>

  <!-- ============================================================ -->
  <!-- RODAS DE APOIO DIANTEIRAS                                     -->
  <!-- ============================================================ -->
  <xacro:caster nome="caster_front_left"  x=" ${rx}" y=" ${ry}"/>
  <xacro:caster nome="caster_front_right" x=" ${rx}" y="-${ry}"/>

  <!-- ============================================================ -->
  <!-- SENSORES: LIDAR, IMU E CÂMERA                                 -->
  <!-- ============================================================ -->
  <link name="lidar_link"/>
  <joint name="lidar_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0.200" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.037" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
      <material name="wheel_dark"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_x/2 - 0.02} 0 0.25" rpy="0 0 0"/>
  </joint>

  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>