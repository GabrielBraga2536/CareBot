<?xml version="1.0"?>
<robot name="robot_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- ARGUMENTOS                                                    -->
  <!-- ============================================================ -->
  <xacro:arg name="sim_mode" default="false" />

  <xacro:if value="$(arg sim_mode)">
    <xacro:include filename="$(find carebot_description)/urdf/robot_diff.gazebo" />
  </xacro:if>
  <xacro:unless value="$(arg sim_mode)">
    <xacro:include filename="$(find carebot_description)/urdf/ros2_control.xacro" />
  </xacro:unless>

  <!-- ============================================================ -->
  <!-- PROPRIEDADES                                                  -->
  <!-- ============================================================ -->

  <!-- Base (chapa): 520x400x6mm -->
  <xacro:property name="base_x"         value="0.520"/>
  <xacro:property name="base_y"         value="0.400"/>
  <xacro:property name="base_z"         value="0.006"/>

  <!-- Rodas: D=118mm, E=30mm -->
  <xacro:property name="roda_r"         value="0.059"/>
  <xacro:property name="roda_e"         value="0.030"/>

  <!-- Layout: vão livre 17mm -->
  <xacro:property name="clearance"      value="0.017"/>

  <!-- Posições calculadas -->
  <xacro:property name="base_link_z"    value="0.020"/>   <!-- base inferior acima do chão -->
  <xacro:property name="roda_z_rel"     value="0.039"/>   <!-- centro roda relativo base_link -->
  <xacro:property name="chapa2_z"       value="0.0567"/>  <!-- relativo base_link -->
  <xacro:property name="chapa3_z"       value="0.1073"/>  <!-- relativo base_link -->

  <!-- Rodas: disposição 335.4x335.4mm -->
  <xacro:property name="rx"             value="0.1677"/>
  <xacro:property name="ry"             value="0.1677"/>

  <!-- STL: origin relativo ao base_link -->
  <xacro:property name="stl_z_offset"   value="0.267"/>

  <!-- ============================================================ -->
  <!-- MACRO: RODA MOTRIZ                                            -->
  <!-- ============================================================ -->
  <xacro:macro name="roda_motriz" params="nome x y axis_y:=1">
    <link name="${nome}">
      <!-- <visual>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="black_${nome}">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual> -->
      <collision>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
      <inertial>
        <mass value="0.8"/>
        <inertia ixx="0.000697" ixy="0" ixz="0"
                 iyy="0.000697" iyz="0"
                 izz="0.001393"/>
      </inertial>
    </link>
    <joint name="${nome}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${nome}"/>
      <origin xyz="${x} ${y} ${roda_z_rel}" rpy="0 0 0"/>
      <axis xyz="0 ${axis_y} 0"/>
      <dynamics damping="0.1" friction="0.2"/>
      <limit effort="100" velocity="20"/>
    </joint>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- MACRO: CASTER WHEEL                                           -->
  <!-- ============================================================ -->
  <xacro:macro name="caster" params="nome x y">
    <link name="${nome}">
      <!-- <visual>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <material name="black_caster_${nome}">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
      </visual> -->
      <collision>
        <geometry>
          <cylinder radius="${roda_r}" length="${roda_e}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.000436" ixy="0" ixz="0"
                 iyy="0.000436" iyz="0"
                 izz="0.000871"/>
      </inertial>
    </link>
    <joint name="${nome}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${nome}"/>
      <origin xyz="${x} ${y} ${roda_z_rel}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.0" friction="0.0"/>
      <limit effort="0" velocity="20"/>
    </joint>
  </xacro:macro>

  <!-- ============================================================ -->
  <!-- FRAMES BASE                                                   -->
  <!-- ============================================================ -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="${rx} 0 ${base_link_z}" rpy="0 0 0"/>
  </joint>

  <!-- base_link: geometria de colisão real (caixa) + visual STL -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find carebot_description)/meshes/robot_diff_visual.stl" scale="1 1 1"/>
      </geometry>
      <origin xyz="0 0 -0.02" rpy="0 0 0"/>
      <material name="robot_body">
        <color rgba="0.85 0.85 0.85 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="8.0"/>
      <inertia ixx="0.0876" ixy="0" ixz="0"
               iyy="0.1311" iyz="0"
               izz="0.2187"/>
    </inertial>
  </link>

  <!-- Chapas 2 e 3 — apenas colisão, visual já está no STL -->
  <link name="chapa_2">
    <collision>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00548" ixy="0" ixz="0"
               iyy="0.00820" iyz="0"
               izz="0.01368"/>
    </inertial>
  </link>
  <joint name="chapa_2_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chapa_2"/>
    <origin xyz="0 0 ${chapa2_z}" rpy="0 0 0"/>
  </joint>

  <link name="chapa_3">
    <collision>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.00548" ixy="0" ixz="0"
               iyy="0.00820" iyz="0"
               izz="0.01368"/>
    </inertial>
  </link>
  <joint name="chapa_3_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chapa_3"/>
    <origin xyz="0 0 ${chapa3_z}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- RODAS MOTRIZES TRASEIRAS                                      -->
  <!-- ============================================================ -->
  <xacro:roda_motriz nome="wheel_left"  x="-${rx}" y=" ${ry}" axis_y="1"/>
  <xacro:roda_motriz nome="wheel_right" x="-${rx}" y="-${ry}" axis_y="1"/>

  <!-- ============================================================ -->
  <!-- RODAS DE APOIO DIANTEIRAS                                     -->
  <!-- ============================================================ -->
  <xacro:caster nome="caster_front_left"  x=" ${rx}" y=" ${ry}"/>
  <xacro:caster nome="caster_front_right" x=" ${rx}" y="-${ry}"/>

  <!-- ============================================================ -->
  <!-- LIDAR                                                         -->
  <!-- ============================================================ -->
  <link name="lidar_link"/>
  <joint name="lidar_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- IMU                                                           -->
  <!-- ============================================================ -->
  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0.037" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- CÂMERA                                                        -->
  <!-- ============================================================ -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
      <material name="black_cam">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.000001" ixy="0" ixz="0"
               iyy="0.000001" iyz="0"
               izz="0.000001"/>
    </inertial>
  </link>
  <joint name="camera_link_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${base_x/2 - 0.02} 0 ${chapa3_z + 0.015}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child  link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

</robot>
