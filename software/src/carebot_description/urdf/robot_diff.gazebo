<?xml version="1.0"?>
<robot name="robot_diff" xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="$(find carebot_description)/urdf/gazebo_control_diff.xacro" />

  <!-- ============================================================ -->
  <!-- CÂMERA                                                        -->
  <!-- ============================================================ -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <camera>
        <horizontal_fov>1.089</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>640</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>8.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- LIDAR                                                         -->
  <!-- ============================================================ -->
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="head_hokuyo_sensor">
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>920</samples>
            <resolution>1</resolution>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.4</min>
          <max>40.0</max>
          <resolution>0.05</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- IMU                                                           -->
  <!-- ============================================================ -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>imu</topic>
      <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
      <pose>0 0 0 0 0 0</pose>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- JOINT STATE PUBLISHER                                         -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
      <joint_name>caster_front_left_joint</joint_name>
      <joint_name>caster_front_right_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ============================================================ -->
  <!-- RODAS MOTRIZES — atrito alto                                  -->
  <!-- ============================================================ -->
  <gazebo reference="wheel_left">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

  <gazebo reference="wheel_right">
    <material>Gazebo/Black</material>
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>

  <!-- ============================================================ -->
  <!-- CASTER WHEELS — atrito zero para girar livremente            -->
  <!-- ============================================================ -->
  <gazebo reference="caster_front_left">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="caster_front_right">
    <material>Gazebo/Black</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ============================================================ -->
  <!-- MATERIAIS                                                     -->
  <!-- ============================================================ -->
  <gazebo reference="base_link">  <material>Gazebo/White</material></gazebo>
<gazebo reference="chapa_2">    <material>Gazebo/FlatBlack</material></gazebo>
<gazebo reference="chapa_3">    <material>Gazebo/White</material></gazebo>
<gazebo reference="perfil_ff">  <material>Gazebo/Grey</material></gazebo>
<gazebo reference="perfil_fd">  <material>Gazebo/Grey</material></gazebo>
<gazebo reference="perfil_tf">  <material>Gazebo/DarkGrey</material></gazebo>
<gazebo reference="perfil_td">  <material>Gazebo/DarkGrey</material></gazebo>

</robot>
